STEPFUN_API_KEY=replace_with_gateway_secret
OPENAGENTS_API_KEY=replace_with_gateway_secret
STEPFUN_BASE_URL=https://api.stepfun.com/step_plan/v1
STEPFUN_NEUTRAL_VOICE=cixingnansheng
INTENT_PROVIDER=stepfun
INTENT_MODEL=step-explore
PROVIDER_MAX_ATTEMPTS=3
ENABLE_VOICE_CLONING=false
GATEWAY_URL=http://127.0.0.1:8000
GATEWAY_TOKEN=replace_with_random_token
GATEWAY_RATE_LIMIT_PER_MINUTE=120
GATEWAY_TIMEOUT_SECONDS=35
GATEWAY_MAX_ASR_AUDIO_SECONDS=20

# Browser demo BFF. Use a separate access code; never expose GATEWAY_TOKEN
# in browser JavaScript.
WEB_DEMO_MODE=mock
WEB_DEMO_TOKEN=replace_with_demo_access_code
WEB_DEMO_VOICE_PROFILE_ID=cixingnansheng
WEB_DEMO_AUDIO_DIR=/tmp/meantbyme-web-demo
WEB_DEMO_MAX_AUDIO_BYTES=16777216
WEB_DEMO_MAX_AUDIO_SECONDS=20
WEB_DEMO_MAX_SESSIONS=100
WEB_DEMO_MAX_PROFILE_BYTES=65536
WEB_DEMO_MAX_UPLOADED_PROFILES=500
# Deterministic Lin Yue demonstration (no cloud ASR/LLM/TTS calls).
WEB_DEMO_LIN_YUE_SCRIPTED=true
WEB_DEMO_LIN_YUE_DELAY_SECONDS=3.5
WEB_DEMO_PROFILE_DB_BACKEND=sqlite
WEB_DEMO_DATABASE_PATH=/tmp/meantbyme-web-demo/profiles.sqlite3

# Deployed user-profile database. In Zeabur, connect the independent MySQL
# service to meantbyme-ios and switch WEB_DEMO_PROFILE_DB_BACKEND to mysql.
# Zeabur's MYSQL_HOST/MYSQL_PORT/MYSQL_USERNAME/MYSQL_PASSWORD variables are
# accepted automatically. The scoped overrides below are optional.
WEB_DEMO_MYSQL_HOST=
WEB_DEMO_MYSQL_PORT=3306
WEB_DEMO_MYSQL_USER=
WEB_DEMO_MYSQL_PASSWORD=
WEB_DEMO_MYSQL_DATABASE=meantbyme
WEB_DEMO_MYSQL_CONNECT_TIMEOUT_SECONDS=5
WEB_DEMO_MYSQL_AUTO_CREATE_SCHEMA=false
# Optional CA certificate path when the MySQL endpoint requires TLS.
WEB_DEMO_MYSQL_SSL_CA=
